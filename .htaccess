# ============================================================
# Never serve secret config files, even if one ends up in the web folder.
# (The real production file is config-easyflow.php, kept OUTSIDE public_html.)
# Works on Apache 2.2 and 2.4.
# ============================================================
<FilesMatch "^config-(easyflow|iorpms)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
